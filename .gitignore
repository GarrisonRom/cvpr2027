# Python environments and local settings
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
.env.*
!.env.example

# Experiment payloads: keep directory markers, never commit the payloads
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/models/base/*
!/models/base/.gitkeep
/models/finetuned/*
!/models/finetuned/.gitkeep
/models/adapters/*
!/models/adapters/.gitkeep
/checkpoints/training/*
!/checkpoints/training/.gitkeep
/checkpoints/release/*
!/checkpoints/release/.gitkeep
/checkpoints/hot_update/*
!/checkpoints/hot_update/.gitkeep
# Per-run outputs are disposable runtime data; keep only the root marker.
/runs/*
!/runs/.gitkeep
/cache/huggingface/*
!/cache/huggingface/.gitkeep
/cache/torch/*
!/cache/torch/.gitkeep
/cache/datasets/*
!/cache/datasets/.gitkeep

# Common large model/data artifacts, in case they are placed outside payload folders
*.safetensors
*.ckpt
*.pth
*.pt
*.msgpack
*.npz
*.npy
*.h5
*.hdf5
*.mp4
*.mkv
*.bag
*.tar
*.tar.gz
*.zip

# LaTeX build products
/main.aux
/main.bbl
/main.blg
/main.brf
/main.fdb_latexmk
/main.fls
/main.log
/main.out
/main.synctex.gz
/main.pdf
